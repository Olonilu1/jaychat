<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:orientation="vertical">
        <ImageView android:id="@+id/img" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="240dp" android:adjustViewBounds="true" android:visibility="gone"
            android:contentDescription="Photo"/>
        <TextView android:id="@+id/body" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@color/bubble_out" android:padding="10dp"
            android:maxWidth="280dp" android:textSize="15sp"/>
    </LinearLayout>
</FrameLayout>
